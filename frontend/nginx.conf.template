# nginx config for the React frontend. The browser only ever calls
# `/api/*` (see src/api.js); this server serves the static bundle and
# strips the /api prefix when forwarding to the backend, so the app is
# origin-agnostic (no CORS) in every deployment shape.
#
# ${FRONTEND_PORT} and ${BACKEND_PROXY} are substituted at container
# start (official nginx image envsubst on /etc/nginx/templates, or
# manual envsubst in deploy/entrypoint.sh for the single-container
# image).
server {
    listen ${FRONTEND_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_PROXY}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Checklist generation is a long synchronous pipeline (~60-90s
        # with real LLM calls); don't let nginx kill it early.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}